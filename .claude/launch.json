{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trekviewer-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5173", "--strictPort"],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "trekviewer-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4174", "--bind", "127.0.0.1", "--directory", "dist"],
      "port": 4174,
      "url": "http://localhost:4174"
    }
  ]
}
