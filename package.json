{
  "name": "trekviewer",
  "private": true,
  "version": "1.0.0",
  "description": "TrekViewer 3D: GPX routes on real terrain as a tabletop model or life-size trail, in the browser and on Meta Quest (WebXR).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest --maxWorkers=2",
    "profile:summary": "node scripts/summarize-profile.mjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm test && npm run build",
    "deploy:surge": "npm run verify && npx surge dist --domain trekviewer.surge.sh",
    "package:apk": "bash scripts/package-quest-apk.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lerc": "^4.2.0",
    "sax": "^1.6.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.2",
    "@types/sax": "^1.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
